{
  "name": "frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "start": "node ../scripts/run-env.mjs --component frontend node .output/server/index.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-devtools": "^0.10.15",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.4",
    "@tanstack/react-start": "^1.169.7",
    "@tauri-apps/api": "^2.12.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.81.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "supertokens-node": "24.1.0",
    "supertokens-web-js": "0.16.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@playwright/test": "^1.65.1",
    "@tanstack/devtools-vite": "^0.8.7",
    "@tanstack/router-cli": "^1.168.0",
    "@tanstack/router-plugin": "^1.169.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "nitro": "3.0.261103-rc",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "intent": {
    "skills": [
      "*"
    ],
    "exclude": [
      "@tanstack/devtools#devtools-app-setup",
      "@tanstack/devtools#devtools-marketplace",
      "@tanstack/devtools#devtools-plugin-panel",
      "@tanstack/devtools#devtools-production",
      "@tanstack/devtools-event-client#devtools-bidirectional",
      "@tanstack/devtools-event-client#devtools-event-client",
      "@tanstack/devtools-event-client#devtools-instrumentation",
      "@tanstack/devtools-vite#devtools-vite-plugin",
      "@tanstack/router-core#router-core",
      "@tanstack/router-core#router-core/auth-and-guards",
      "@tanstack/router-core#router-core/code-splitting",
      "@tanstack/router-core#router-core/data-loading",
      "@tanstack/router-core#router-core/navigation",
      "@tanstack/router-core#router-core/not-found-and-errors",
      "@tanstack/router-core#router-core/path-params",
      "@tanstack/router-core#router-core/search-params",
      "@tanstack/router-core#router-core/ssr",
      "@tanstack/router-core#router-core/type-safety",
      "@tanstack/router-plugin#router-plugin",
      "@tanstack/virtual-file-routes#virtual-file-routes"
    ]
  }
}
